{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "packages/config/*.json",
    "packages/config/*.js",
    ".nvmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!test/**", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "@sellmanager/api#build": {
      "dependsOn": ["^build", "openapi:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.spec.ts", "!test/**", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.spec.ts",
        "!test/**",
        "!openapi.json"
      ],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"]
    },
    "@sellmanager/api-client#generate": {
      "dependsOn": ["@sellmanager/api#openapi:generate"],
      "inputs": ["$TURBO_ROOT$/apps/api/openapi.json", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
