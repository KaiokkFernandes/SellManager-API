{
  "name": "sellmanager",
  "private": true,
  "description": "Monorepo do SellManager: API (apps/api), front-end (apps/web) e pacotes compartilhados",
  "repository": "git@github.com:KaiokkFernandes/SellManager-API.git",
  "author": "KaiokkFernandes <kaiofernandess654@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write . && turbo run format",
    "format:check": "prettier --check . && turbo run format:check"
  },
  "prettier": "@sellmanager/config/prettier",
  "devDependencies": {
    "@sellmanager/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
