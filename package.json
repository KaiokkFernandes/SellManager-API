{
  "name": "sellmanager-api",
  "version": "1.0.0",
  "description": "API REST de gestão de vendas (Node.js + TypeScript + Express + TypeORM) seguindo Clean Architecture",
  "private": true,
  "repository": "git@github.com:KaiokkFernandes/SellManager-API.git",
  "author": "KaiokkFernandes <kaiofernandess654@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/shared/http/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/shared/http/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:run": "yarn typeorm migration:run -d src/shared/infra/typeorm/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d src/shared/infra/typeorm/data-source.ts",
    "migration:create": "yarn typeorm migration:create",
    "migration:run:prod": "typeorm migration:run -d dist/shared/infra/typeorm/data-source.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "celebrate": "^15.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "handlebars": "^4.7.8",
    "jose": "^6.2.13",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  }
}
