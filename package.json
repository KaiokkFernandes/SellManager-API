    "eslint": "^9.12.0",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-prettier": "3.2.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "celebrate": "^15.0.3",
