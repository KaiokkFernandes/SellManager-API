{
  "name": "sellmanager",
  "private": true,
  "description": "Monorepo do SellManager: API (apps/api), front-end (apps/web) e pacotes compartilhados",
  "repository": "git@github.com:KaiokkFernandes/SellManager-API.git",
  "author": "KaiokkFernandes <kaiofernandess654@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  }
}
