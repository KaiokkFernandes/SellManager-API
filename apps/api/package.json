{
  "name": "@sellmanager/api",
  "version": "1.0.0",
  "description": "API REST de gestão de vendas (Node.js + TypeScript + Express + TypeORM) seguindo Clean Architecture",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/shared/http/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/shared/http/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:run": "pnpm typeorm migration:run -d src/shared/infra/typeorm/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/shared/infra/typeorm/data-source.ts",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run:prod": "typeorm migration:run -d dist/shared/infra/typeorm/data-source.js",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx src/shared/infra/cli/createAdmin.ts",
    "create-admin:prod": "node dist/shared/infra/cli/createAdmin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "docs:permissions": "tsx scripts/permissions-doc.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8",
    "vitest": "^5.0.5",
    "@sellmanager/config": "workspace:*"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@sellmanager/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "prettier": "@sellmanager/config/prettier"
}
