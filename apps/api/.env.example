# Copie para .env e ajuste os valores.
NODE_ENV=development
PORT=3333
APP_API_URL=http://localhost:3333
# URL do front-end, usada no link de recuperação de senha
APP_WEB_URL=http://localhost:3000

# PostgreSQL (docker compose up -d postgres)
DB_HOST=localhost
DB_PORT=5433
DB_USER=sellmanager
DB_PASSWORD=sellmanager
DB_NAME=sellmanager

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=2h

# Origens do front-end permitidas no CORS (separadas por vírgula; * libera todas)
CORS_ORIGIN=http://localhost:3000
# Quantidade de proxies reversos à frente da API (0 = acesso direto)
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent (padrão depende do NODE_ENV)
# LOG_LEVEL=info

# Custo do bcrypt (10 a 15)
BCRYPT_SALT_ROUNDS=12

# E-mail: smtp (padrão aqui: Mailpit do docker-compose, UI em http://localhost:8025)
# ou ethereal (caixa de teste online; o link de preview aparece no log)
MAIL_DRIVER=smtp
MAIL_FROM_NAME=Equipe SellManager
MAIL_FROM_EMAIL=no-reply@sellmanager.dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Credenciais do provedor SMTP real (não usadas pelo Mailpit)
# SMTP_USER=
# SMTP_PASS=
