# Copie para .env e ajuste os valores. Nada aqui é segredo real.
# Valores de produção: veja DEPLOY.md, na raiz do repositório.
NODE_ENV=development
PORT=3333
APP_API_URL=http://localhost:3333
# URL do front-end, usada no link de recuperação de senha.
# Na Vercel é derivada do domínio de produção se não for definida.
APP_WEB_URL=http://localhost:3000
# fuso das métricas de vendas (IANA)
BUSINESS_TIMEZONE=America/Sao_Paulo

# PostgreSQL local (docker compose up -d postgres)
DB_HOST=localhost
DB_PORT=5433
DB_USER=sellmanager
DB_PASSWORD=sellmanager
DB_NAME=sellmanager

# Produção (Neon). Têm precedência sobre DB_* e DATABASE_URL é obrigatória.
# Com pooler (host com -pooler): usada pelo app.
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.us-east-1.aws.neon.tech/banco?sslmode=require
# Direta (sem -pooler): usada só nas migrations. Sem ela, valem a DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/banco?sslmode=require

# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=2h

# Origens de OUTROS domínios, separadas por vírgula. Opcional em produção: a
# origem igual ao host da requisição é sempre aceita. * é recusado em produção.
CORS_ORIGIN=http://localhost:3000
# Quantidade de proxies reversos à frente da API (0 = acesso direto; 1 na Vercel)
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent (padrão depende do NODE_ENV)
# LOG_LEVEL=info

# Custo do bcrypt (10 a 15)
BCRYPT_SALT_ROUNDS=12

# Imagens: disk (pasta local, só desenvolvimento) ou blob (Vercel Blob, padrão na Vercel)
STORAGE_DRIVER=disk
# Obrigatória com STORAGE_DRIVER=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_exemplo

# Contador do rate limit. Sem ela, fica em memória (só um processo).
# Obrigatória na produção da Vercel, com rediss://
# REDIS_URL=rediss://default:token@exemplo.upstash.io:6379

# E-mail: smtp (padrão aqui: Mailpit do docker-compose, UI em http://localhost:8025)
# ou ethereal (caixa de teste online; o link de preview aparece no log).
# Na produção da Vercel, só smtp.
MAIL_DRIVER=smtp
MAIL_FROM_NAME=Equipe SellManager
MAIL_FROM_EMAIL=no-reply@sellmanager.dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Credenciais do provedor SMTP real (não usadas pelo Mailpit)
# SMTP_USER=
# SMTP_PASS=
