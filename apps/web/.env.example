# URL base da API usada pelo front-end.
# Em dev use "/api": o proxy do Vite encaminha para a API (sem CORS).
# Em produção use a URL absoluta da API (ex.: https://api.exemplo.com).
VITE_API_URL=/api

# Só dev: para onde o proxy do Vite encaminha /api (padrão http://localhost:3333)
# API_PROXY_TARGET=http://localhost:3333
