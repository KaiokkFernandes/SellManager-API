{
  "name": "@sellmanager/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas zod e tipos compartilhados entre a API e o front-end",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@sellmanager/config/prettier",
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sellmanager/config": "workspace:*",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vite": "^8",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
