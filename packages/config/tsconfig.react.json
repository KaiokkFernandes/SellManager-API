{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Apps React com Vite (ESM, resolução bundler)",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noEmit": true
  }
}
