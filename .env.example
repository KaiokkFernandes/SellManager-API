# Copie para .env e ajuste os valores.
NODE_ENV=development
PORT=3333
APP_API_URL=http://localhost:3333
# URL do front-end, usada no link de recuperação de senha
APP_WEB_URL=http://localhost:3000

# PostgreSQL (docker compose up -d postgres)
DB_HOST=localhost
DB_PORT=5433
DB_USER=sellmanager
DB_PASSWORD=sellmanager
DB_NAME=sellmanager

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d
